# Pit Wall API - Development Environment
# Copy this file to .env.local for local overrides if needed

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pitwall

# JWT Secret (min 32 chars for production)
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars

# Server
PORT=3000
NODE_ENV=development

# Email (Resend) - optional for dev
RESEND_API_KEY=
EMAIL_FROM=noreply@pitwall.local

# File Storage
STORAGE_PATH=./storage

# Auth
SESSION_TTL_DAYS=30
RESET_TOKEN_TTL_HOURS=1